# ============================================================
# SmartPark Mall - Git Ignore Configuration
# ============================================================

# Dependencies
node_modules/
*/node_modules/
.pnp/
.pnp.js

# Environment Variables & Secrets (NEVER commit credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
client/.env
client/.env.local
server/.env
server/.env.local
!.env.example
!client/.env.example
!server/.env.example

# Production Builds
dist/
dist-ssr/
build/
client/dist/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache directories
.cache/
.vite/
client/.vite/
.eslintcache
.stylelintcache
.parcel-cache

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
tmp/
temp/
*.tmp
